# Configuración del servidor
NODE_ENV=development
PORT=3000

# Conexión a Base de Datos PostgreSQL (ej. Supabase, Neon o PostgreSQL Local)
# Formato: postgres://usuario:password@host:puerto/nombre_bd?sslmode=require
DATABASE_URL=postgres://postgres:tu_password_local@localhost:5432/gym_db

# Clave secreta para JWT o sesiones (mínimo 32 caracteres)
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_gym_2026

# URL del Frontend (para CORS restrictivo)
FRONTEND_URL=http://localhost:5173
