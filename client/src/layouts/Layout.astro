---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Proyecto Gym — Sistema de Gestión y Control en COP",
  description = "Sistema integral para gimnasios con control de miembros, caja diaria, verificación por correo y marcación por cédula."
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph para compartir en WhatsApp y LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="es_CO" />

    <!-- Fuentes Modernas -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-emerald-400 selection:text-zinc-950 min-h-screen bg-zinc-950 text-zinc-100">
    <!-- Navbar de Recepción -->
    <header class="border-b border-zinc-800/80 sticky top-0 z-40 backdrop-blur-xl bg-zinc-950/80">
      <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-emerald-400 flex items-center justify-center font-bold text-zinc-950 font-mono shadow-md shadow-emerald-400/20 group-hover:scale-105 transition-transform">
            🏋️
          </div>
          <div>
            <span class="font-extrabold text-sm tracking-tight text-white block leading-none group-hover:text-emerald-400 transition">
              PROYECTO GYM
            </span>
            <span class="text-[10px] font-mono text-zinc-400 uppercase tracking-wider">
              Control & Recepción
            </span>
          </div>
        </a>

        <div class="flex items-center gap-3">
          <div class="hidden sm:flex items-center gap-2 px-2.5 py-1 rounded-md bg-zinc-900 border border-zinc-800 text-[11px] font-mono text-zinc-300">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Mensualidad: $60.000 COP</span>
          </div>
          <div class="px-2.5 py-1 rounded-md bg-emerald-500/10 border border-emerald-500/20 text-[11px] font-mono text-emerald-400 font-bold">
            🇨🇴 Colombia
          </div>
        </div>
      </div>
    </header>

    <!-- Contenido Principal -->
    <main class="max-w-7xl mx-auto px-6 py-6">
      <slot />
    </main>

    <!-- Footer Discreto -->
    <footer class="border-t border-zinc-800/80 py-6 mt-16 text-center text-xs text-zinc-500 font-mono">
      <p>Proyecto Gym · Construido con Astro 5, React 19, Tailwind v4, Hono y PostgreSQL.</p>
    </footer>
  </body>
</html>
